# Copie para .env (nao versionar). docker compose --env-file .env up -d
MYSQL_DATABASE=elevatecontrol
MYSQL_USER=elevate
MYSQL_PASSWORD=elevate_dev
MYSQL_ROOT_PASSWORD=root_dev_apenas_local
# Variaveis para iniciar a API com Maven/VS Code:
DB_URL=jdbc:mysql://localhost:3306/elevatecontrol?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
DB_USER=elevate
DB_PASSWORD=elevate_dev
BOOTSTRAP_ADMIN_EMAIL=instalacao@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrador Inicial
FRONTEND_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
# SMTP (necessario para recuperacao de senha real):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
FRONTEND_RESET_URL=http://localhost:5173/reset-password
